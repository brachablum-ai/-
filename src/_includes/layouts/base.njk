<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | {{ site.businessName }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta name="theme-color" content="{{ site.themeColor }}">

<meta property="og:type" content="website">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:site_name" content="{{ site.businessName }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">

<link rel="icon" href="/favicon.svg" type="image/svg+xml">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700;900&family=Assistant:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">

<script type="application/ld+json">
{{ ldPerson | jsonify | safe }}
</script>
{% if faq and faq.length %}
<script type="application/ld+json">
{{ faq | toFaqSchema | jsonify | safe }}
</script>
{% endif %}
</head>
<body>
<a class="skip-link" href="#main">דלגו לתוכן הראשי</a>

{% include "partials/header.njk" %}

<div class="trail" aria-hidden="true">
  <svg viewBox="0 0 400 26" preserveAspectRatio="none"><path d="M0 13 Q 25 2 50 13 T 100 13 T 150 13 T 200 13 T 250 13 T 300 13 T 350 13 T 400 13" fill="none" stroke="#0F6B66" stroke-width="2" opacity="0.25"/></svg>
</div>

<main id="main">
  {{ content | safe }}
</main>

{% include "partials/footer.njk" %}

<script src="/assets/js/main.js"></script>
</body>
</html>
